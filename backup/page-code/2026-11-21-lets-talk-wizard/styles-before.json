{
  "_note": "Base (main) properties of styles changed for the wizard, read from Webflow 21.11.2026 before changes. Breakpoint overrides listed where they existed.",
  "lt-form": {"display":"flex","width":"100%","flex-direction":"column"},
  "lt-form_steps": {"display":"flex","padding":"22px 24px","justify-content":"center","flex-wrap":"wrap","align-items":"center","border-bottom":"1px solid rgba(13,25,40,0.1)","column-gap":"24px","row-gap":"8px","tiny":{"padding":"18px","column-gap":"16px"}},
  "lt-form_body": {"padding":"28px 24px 30px","tiny":{"padding":"24px 18px 26px"}},
  "lt-form_panel": {"display":"block"},
  "lt-form_form-block": {"margin-bottom":"0px"},
  "lt-form_form": {"display":"flex","margin-bottom":"0px","flex-direction":"column","row-gap":"20px"},
  "lt-form_options": {"display":"flex","flex-direction":"column","row-gap":"10px"},
  "lt-form_option": {"display":"flex","margin-bottom":"0px","padding-left":"0px","align-items":"center","column-gap":"10px","cursor":"pointer"},
  "lt-form_option-text": {"margin-bottom":"0px","color":"#0d1928","font-size":"16px","line-height":"1.3","font-weight":"400","letter-spacing":"-0.01em"},
  "lt-form_radio": {"width":"18px","height":"18px","margin":"0px","flex":"0 0 auto"},
  "lt-form_submit": {"width":"100%","height":"56px","margin-top":"6px","padding":"0 24px","border-radius":"14px","background-color":"#0d1928","color":"#ffffff","font-size":"17px","line-height":"1.2","font-weight":"500","letter-spacing":"-0.02em","cursor":"pointer","transition":"background-color 300ms ease"},
  "lt-form_preview": {"position":"relative","margin-top":"28px"},
  "lt-cal": {"display":"flex","flex-direction":"column","row-gap":"16px"},
  "lt-cal_slots": {"display":"flex","max-height":"320px","padding-right":"4px","flex-direction":"column","row-gap":"8px","overflow-y":"auto"},
  "lt-cal_slot": {"width":"100%","padding":"12px","border":"1px solid rgba(13,25,40,0.12)","border-radius":"10px","background-color":"#ffffff","font-family":"inherit","color":"#0d1928","font-size":"15px","line-height":"1.2","text-align":"center","cursor":"pointer"},
  "lt-cal_day": {"position":"relative","padding":"10px 0","border":"none","border-radius":"8px","background-color":"transparent","font-family":"inherit","color":"rgba(13,25,40,0.3)","font-size":"14px","line-height":"1.2","cursor":"default"},
  "lt-cal_grid": {"display":"grid","grid-template-columns":"1fr x7","text-align":"center","column-gap":"6px","row-gap":"6px"},
  "lt-cal_add": {"padding":"9px 14px","align-self":"flex-start","border":"1px solid rgba(13,25,40,0.12)","border-radius":"9px","background-color":"#ffffff","color":"#0d1928","font-size":"14px","cursor":"pointer"},
  "lt-cal_guests": {"display":"flex","padding-top":"16px","flex-direction":"column","border-top":"1px solid rgba(13,25,40,0.12)","row-gap":"10px"},
  "lt-cal_day-head": {"display":"flex","padding-top":"16px","justify-content":"space-between","align-items":"center","border-top":"1px solid rgba(13,25,40,0.12)"},
  "lt-cal_done": {"display":"flex","padding":"12px 0","flex-direction":"column","align-items":"center","text-align":"center","row-gap":"10px"},
  "lt-cal_confirm": {"padding":"12px","border":"none","border-radius":"10px","background-color":"#0d1928","font-family":"inherit","color":"#ffffff","font-size":"15px","line-height":"1.2","font-weight":"500","cursor":"pointer"}
}
